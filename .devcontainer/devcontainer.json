{
    "name": "solakon-dev",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "UID": "${localEnv:UID:1000}",
            "GID": "${localEnv:GID:1000}"
        }
    },
    "runArgs": [
        "--hostname",
        "solakon-dev",
        "--env-file",
        ".devcontainer/container.env"
    ],
    "mounts": [
        "source=${localEnv:HOME}/.gitconfig,target=/home/developer/.gitconfig,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.ssh,target=/home/developer/.ssh,type=bind,consistency=cached"
    ],
    "workspaceFolder": "/workspaces/solakon-one-homeassistant",
    "remoteUser": "developer",
    "remoteEnv": {
        "PYTHONPATH": "${containerWorkspaceFolder}/solakon-one-homeassistant/custom_components",
        "PYTHONPYCACHEPREFIX": "${containerWorkspaceFolder}/.caches/python"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "njpwerner.autodocstring",
                "eamodio.gitlens",
                "littlefoxteam.vscode-python-test-adapter",
                "charliermarsh.ruff"
            ],
            "settings": {
                "terminal.integrated.cwd": "/workspaces/solakon-one-homeassistant",
                "python.analysis.typeCheckingMode": "standard",
                "python.testing.pytestArgs": [
                    "tests"
                ],
                "python.testing.unittestEnabled": false,
                "python.testing.pytestEnabled": true,
                "pythonTestExplorer.testFramework": "pytest",
                "python.analysis.inlayHints.pytestParameters": true
            }
        }
    }
}